# Server Configuration
PORT=4000
NODE_ENV=DEVELOPMENT
ALLOWED_ORIGINS=http://localhost:3333  # comma-separated, e.g. https://drsaharpediatrics.com,https://www.drsaharpediatrics.com

# Public URL of the web app. Used for Stripe return URLs and for the links in
# notification emails — set this in production or those links point at localhost.
FRONTEND_URL=http://localhost:3333

# Supabase Configuration
# Get these from: Supabase Dashboard > Settings > API
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # ⚠️ IMPORTANT: Service role key (has admin privileges)
SUPABASE_ANON_KEY=your-anon-key

# JWT Configuration
# Get this from: Supabase Dashboard > Settings > API > JWT Settings
JWT_SECRET=your-jwt-secret

# Payment Integration (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Video Integration (Daily.co)
# Get this from: https://dashboard.daily.co/developers
DAILY_API_KEY=your-daily-api-key

# Email Service (Resend)
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Google Calendar (admin-connected clinic account)
# Reuses the Google Sign-In OAuth client — see GOOGLE_CALENDAR_SETUP.md.
# GOOGLE_REDIRECT_URI must exactly match an authorized redirect URI on that client.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google-calendar/callback
