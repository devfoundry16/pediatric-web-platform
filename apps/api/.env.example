# Server Configuration
PORT=4000
NODE_ENV=DEVELOPMENT
ALLOWED_ORIGINS=http://localhost:3333  # comma-separated, e.g. https://drsaharpediatrics.com,https://www.drsaharpediatrics.com

# Supabase Configuration
# Get these from: Supabase Dashboard > Settings > API
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # ⚠️ IMPORTANT: Service role key (has admin privileges)
SUPABASE_ANON_KEY=your-anon-key

# JWT Configuration
# Get this from: Supabase Dashboard > Settings > API > JWT Settings
JWT_SECRET=your-jwt-secret

# Payment Integration (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Video Integration (Daily.co)
# Get this from: https://dashboard.daily.co/developers
DAILY_API_KEY=your-daily-api-key

# Email Service (Resend)
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com
